<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ws_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:paddingStart="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Baterai " android:textColor="#FF9DB0AD" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/ws_battery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFE2ECEA" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="   Suhu " android:textColor="#FF9DB0AD" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/ws_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFE2ECEA" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="   RAM " android:textColor="#FF9DB0AD" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/ws_ram" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFE2ECEA" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <TextView android:id="@+id/ws_overlay" android:layout_width="44dp" android:layout_height="26dp"
        android:background="@drawable/widget_btn_outline" android:gravity="center" android:text="Off"
        android:textColor="#FFE2ECEA" android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
</LinearLayout>
